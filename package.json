{
  "name": "firstloop-marathon-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "knip": "knip",
    "test": "bun test --path-ignore-patterns '**/dist/**'",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "knip": "^5.42.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
