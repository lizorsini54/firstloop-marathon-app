# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://firstloop:firstloop@localhost:5432/firstloop"

# apps/server
SERVER_PORT=3001
# Full origin incl. scheme (used for CORS) — Railway's dashboard shows domains
# without "https://"; pasting the bare domain here silently breaks CORS.
WEB_ORIGIN="http://localhost:5173"
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
# Optional — powers the AI Coach card on the dashboard. Leave unset and the
# endpoint reports itself unavailable instead of erroring; nothing else breaks,
# and no test or CI run needs it.
ANTHROPIC_API_KEY=""

# apps/web (must be prefixed VITE_ to be exposed to the client, baked in at build time)
# Full URL incl. scheme — a bare domain here breaks the oRPC client's URL parsing.
VITE_API_URL="http://localhost:3001"
VITE_CLERK_PUBLISHABLE_KEY=""
